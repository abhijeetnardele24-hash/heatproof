# HeatProof Environment Configuration Template
# DO NOT COMMIT PRIVATE KEYS OR SENSITIVE SECRETS TO GIT.

# Public Meteorological Ingestion
VITE_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Arbitrum Sepolia Testnet RPC (Chain ID: 421614)
# Optional custom public RPC endpoint:
VITE_ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc

# HeatProof Anchor Contract Address (Arbitrum Sepolia)
# Set to an audited deployment on Arbitrum Sepolia when available
VITE_HEATPROOF_ANCHOR_CONTRACT_ADDRESS=

# Ledger Operating Mode Default: LOCAL_DEMO | TESTNET
VITE_DEFAULT_LEDGER_MODE=LOCAL_DEMO
